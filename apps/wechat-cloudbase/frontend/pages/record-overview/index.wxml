<scroll-view scroll-y="{{!modalOpen}}" enhanced show-scrollbar="{{false}}" refresher-enabled="{{true}}" refresher-triggered="{{isRefreshing}}" bindrefresherrefresh="onPullDownRefresh" class="record-overview-scroll {{modalOpen ? 'modal-open' : ''}}" style="{{layoutStyle}}">
  <view class="record-overview-page {{themeClass}}">
    <subpage-header title="全部记录" bind:back="back" />

    <view class="card overview-summary-card">
      <view class="overview-summary-head">
        <view>
          <text class="kicker">总览</text>
          <view class="overview-title">{{summary.total}} 条记录</view>
        </view>
        <text class="pill blue">全部</text>
      </view>
      <view class="overview-grid">
        <view class="overview-metric">
          <text class="metric-value">{{summary.inspiration}}</text>
          <text class="metric-label">灵感</text>
        </view>
        <view class="overview-metric">
          <text class="metric-value">{{summary.practice}}</text>
          <text class="metric-label">素材练习</text>
        </view>
        <view class="overview-metric">
          <text class="metric-value">{{summary.rehearsal}}</text>
          <text class="metric-label">排练</text>
        </view>
        <view class="overview-metric">
          <text class="metric-value">{{summary.method}}</text>
          <text class="metric-label">方法卡</text>
        </view>
      </view>
    </view>

    <view class="record-filter-panel">
      <view class="filter-row">
        <button wx:for="{{filterOptions}}" wx:key="value" class="chip compact-filter-chip {{item.activeClass}}" data-value="{{item.value}}" bindtap="setFilter">{{item.label}}</button>
      </view>
    </view>

    <view wx:if="{{errorText}}" class="notice-note-card">{{errorText}}</view>
    <empty-state-panel wx:if="{{loading}}" tone="loading" title="正在加载记录" />
    <empty-state-panel wx:elif="{{!items.length}}" title="没有匹配记录" desc="换个筛选，或先留下一条。" primaryText="查看全部" secondaryText="返回记录" bind:primary="handleEmptyPrimary" bind:secondary="back" />

    <view wx:else class="overview-list">
      <view wx:for="{{items}}" wx:key="id" class="card overview-record-card" data-id="{{item.id}}" bindtap="openDetail">
        <view class="overview-record-head">
          <text class="record-type {{item.type}}">{{item.typeLabel}}</text>
          <text class="muted">{{item.dateLabel}}</text>
        </view>
        <view class="overview-record-title">{{item.title}}</view>
        <text class="muted overview-record-desc">{{item.desc}}</text>
        <view wx:if="{{item.meta.length}}" class="meta-row overview-meta">
          <text wx:for="{{item.meta}}" wx:key="*this" class="meta-pill">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <bottom-sheet visible="{{detailVisible}}" title="记录详情" sheetClass="record-overview-detail-sheet" bind:close="closeDetail">
    <view wx:if="{{selectedItem}}" class="overview-detail-panel">
      <view class="overview-record-head">
        <text class="record-type {{selectedItem.type}}">{{selectedItem.typeLabel}}</text>
        <text class="muted">{{selectedItem.dateLabel}}</text>
      </view>
      <view class="section-title">{{selectedItem.title}}</view>
      <text class="muted detail-desc">{{selectedItem.desc}}</text>
      <view wx:if="{{selectedItem.meta.length}}" class="meta-row overview-meta">
        <text wx:for="{{selectedItem.meta}}" wx:key="*this" class="meta-pill">{{item}}</text>
      </view>
      <button wx:if="{{selectedItem.type === 'practice' && selectedItem.materialId}}" class="primary-btn material-record-link" bindtap="openMaterialRecords">查看该素材全部记录</button>
    </view>
  </bottom-sheet>

  <root-portal wx:if="{{appToastVisible}}">
    <view class="app-toast app-toast-{{appToastTone}} {{themeClass}}"><text>{{appToastTitle}}</text></view>
  </root-portal>
</scroll-view>
