@import '../../styles/theme.wxss';

.privacy-page {
  width: 100%;
  height: 100vh;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: var(--nav-row-top) var(--page-side) 0;
  background: linear-gradient(180deg, #fafaf7 0%, #f7f8f3 54%, #f3f7f5 100%);
  background: linear-gradient(180deg, var(--improv-bg-top, #fafaf7) 0%, var(--improv-bg-mid, #f7f8f3) 54%, var(--improv-bg-bottom, #f3f7f5) 100%);
  color: var(--improv-text);
}

.privacy-scroll {
  flex: 1 1 auto;
  min-height: 0;
  margin-top: 24rpx;
}

.privacy-content {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 8rpx 0 calc(60rpx + env(safe-area-inset-bottom));
}

.privacy-updated {
  font-size: 24rpx;
  color: var(--improv-text-muted);
}

.privacy-summary-card,
.privacy-section-card {
  width: 100%;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: var(--improv-card, #ffffff);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.02);
}

.privacy-summary-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding: 28rpx 32rpx;
  border: 2rpx solid var(--improv-line-subtle);
}

.privacy-summary-item {
  display: block;
  color: var(--improv-text);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.5;
}

.privacy-section-card {
  display: flex;
  flex-direction: column;
  padding: 30rpx 32rpx 24rpx;
}

.privacy-section-title {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--improv-text);
  margin-bottom: 14rpx;
}

.privacy-text {
  font-size: 26rpx;
  color: var(--improv-text-soft);
  line-height: 1.7;
  margin-bottom: 10rpx;
}

.privacy-text:last-child {
  margin-bottom: 0;
}
