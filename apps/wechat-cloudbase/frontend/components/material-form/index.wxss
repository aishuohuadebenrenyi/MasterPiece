@import "../../app.wxss";
@import "../../styles/theme.wxss";

:host {
  display: block;
  width: 100%;
}

.material-form {
  display: flex;
  flex-direction: column;
  width: 100%;
  gap: var(--improv-form-gap-related, 28rpx);
  padding-bottom: 34rpx;
}

.material-form-group {
  display: flex;
  flex-direction: column;
}

.primary-group {
  gap: var(--improv-form-gap-section, 36rpx);
}

.advanced-group {
  gap: var(--improv-form-gap-related, 24rpx);
}

.advanced-toggle-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0 4rpx;
  position: relative;
  z-index: 1;
}

.form-grid {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 8rpx;
}

.add-sheet-grid-item {
  flex: 1 1 0;
  width: 0;
  min-width: 0;
}

.category-stack {
  display: flex;
  flex-direction: column;
  flex: 0 0 auto;
  gap: 34rpx;
  padding-top: 2rpx;
  padding-bottom: 12rpx;
}

.add-sheet-grid-item .input-shell {
  width: 100%;
}

.material-title-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.material-title-label {
  color: var(--improv-text);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.4;
}

.material-form .app-input {
  box-sizing: border-box;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0 32rpx;
  line-height: 88rpx;
}

.material-form .material-title-input {
  padding: 0 28rpx;
  border: 2rpx solid var(--improv-line-subtle, rgba(68, 108, 140, 0.12));
  border-radius: 24rpx;
  background: var(--improv-bg-subtle, #f7f9fe);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.72);
  transition: border-color var(--improv-anim-fast) ease, background var(--improv-anim-fast) ease, box-shadow var(--improv-anim-fast) ease;
}

.material-form .material-title-input.is-focused {
  border-color: var(--improv-primary-wash, rgba(255, 159, 28, 0.42));
  background: var(--improv-card-strong, #ffffff);
  box-shadow: 0 0 0 6rpx var(--improv-primary-wash, rgba(255, 159, 28, 0.16));
}

.material-form .app-textarea {
  box-sizing: border-box;
  min-height: 190rpx;
  padding: 24rpx 32rpx;
  line-height: 1.5;
}

.custom-category-chip.active {
  background: var(--improv-primary-wash);
  border: 2rpx solid var(--improv-primary);
  color: var(--improv-primary);
}

.custom-category-chip {
  display: inline-flex;
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
  max-width: 100%;
  margin: 0 !important;
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.custom-category-panel {
  margin-top: var(--improv-form-gap-inline, 16rpx);
  padding: 18rpx;
  border-radius: 24rpx;
  background: var(--improv-bg-subtle-glass);
  border: 2rpx solid var(--improv-neutral-line);
}

.custom-category-input {
  width: 100%;
}

.custom-category-input input {
  min-height: 88rpx;
}

.category-suggestions {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--improv-form-gap-inline, 16rpx);
  margin-top: var(--improv-form-gap-inline, 16rpx);
}

.category-suggestion {
  min-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--improv-card-strong);
  border: 2rpx solid var(--improv-blue-line-strong);
  color: var(--improv-secondary-strong);
  font-size: 24rpx;
  font-weight: 900;
}

.custom-category-confirm {
  display: inline-flex;
  flex: 0 0 auto;
  width: auto;
  min-width: 0;
  max-width: 100%;
  min-height: 64rpx;
  margin-top: var(--improv-form-gap-inline, 16rpx);
  align-self: flex-start;
  padding: 0 28rpx;
  font-size: 24rpx;
}

.steps-toggle {
  min-width: 240rpx;
  min-height: 70rpx;
  margin: 0 !important;
  align-self: flex-start;
  padding: 0 40rpx;
  border-radius: 24rpx;
  background: var(--improv-btn-tertiary-bg);
  border: 2rpx solid var(--improv-btn-tertiary-border);
  color: var(--improv-btn-tertiary-text);
  font-size: 26rpx;
  font-weight: 900;
  justify-content: center;
  line-height: 1;
  white-space: nowrap;
}

.steps-textarea {
  min-height: 180rpx;
}
